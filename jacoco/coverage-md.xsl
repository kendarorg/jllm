<?xml version="1.0" encoding="UTF-8"?>
<!-- jacoco.xml (DOCTYPE removed) -> Markdown index of the coverage, one row per package. -->
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
    <xsl:output method="text" encoding="UTF-8"/>

    <xsl:template name="pct">
        <xsl:param name="c"/>
        <xsl:variable name="t" select="$c/@missed + $c/@covered"/>
        <xsl:choose>
            <xsl:when test="not($c) or $t = 0">-</xsl:when>
            <xsl:otherwise><xsl:value-of select="format-number($c/@covered div $t, '0.0%')"/></xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <xsl:template name="row">
        <xsl:param name="name"/>
        <xsl:param name="node"/>
        <xsl:variable name="line" select="$node/counter[@type='LINE']"/>
        <xsl:text>| </xsl:text><xsl:value-of select="$name"/>
        <xsl:text> | </xsl:text>
        <xsl:call-template name="pct"><xsl:with-param name="c" select="$line"/></xsl:call-template>
        <xsl:text> | </xsl:text>
        <xsl:call-template name="pct"><xsl:with-param name="c" select="$node/counter[@type='BRANCH']"/></xsl:call-template>
        <xsl:text> | </xsl:text>
        <xsl:call-template name="pct"><xsl:with-param name="c" select="$node/counter[@type='INSTRUCTION']"/></xsl:call-template>
        <xsl:text> | </xsl:text>
        <xsl:value-of select="$line/@covered"/><xsl:text> / </xsl:text><xsl:value-of select="$line/@missed + $line/@covered"/>
        <xsl:text> |&#10;</xsl:text>
    </xsl:template>

    <xsl:template match="/report">
        <xsl:text># Test coverage&#10;&#10;</xsl:text>
        <xsl:text>Generated by `mvn test` (module `jacoco`, JaCoCo aggregate of all modules). The HTML report is written to&#10;</xsl:text>
        <xsl:text>`docs/coverage/html/` and is not committed; only this index is.&#10;&#10;</xsl:text>
        <xsl:text>| Package | Lines | Branches | Instructions | Covered lines |&#10;</xsl:text>
        <xsl:text>|---|---:|---:|---:|---:|&#10;</xsl:text>
        <xsl:call-template name="row">
            <xsl:with-param name="name">**Total**</xsl:with-param>
            <xsl:with-param name="node" select="."/>
        </xsl:call-template>
        <xsl:for-each select="package">
            <xsl:sort select="@name"/>
            <xsl:call-template name="row">
                <xsl:with-param name="name" select="concat('`', translate(@name, '/', '.'), '`')"/>
                <xsl:with-param name="node" select="."/>
            </xsl:call-template>
        </xsl:for-each>
    </xsl:template>
</xsl:stylesheet>
