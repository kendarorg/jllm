<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.kendar.llm</groupId>
    <artifactId>jllm</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>jllm</name>
    <description>Java LLM harness: tools, MCP, sandboxed JS, plugins, CLI and web front end.</description>
    <url>https://github.com/kendarorg/jllm</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>kendarorg</id>
            <name>Enrico Da Ros</name>
            <email>github@kendar.org</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/kendarorg/jllm.git</connection>
        <developerConnection>scm:git:git://github.com/kendarorg/jllm.git</developerConnection>
        <url>https://www.github.com/kendarorg/jllm</url>
        <tag>HEAD</tag>
    </scm>

    <distributionManagement>
        <repository>
            <id>central</id>
            <name>central</name>
            <url>https://central.sonatype.com</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>core</module>
        <module>plugins</module>
        <module>jllm-cli</module>
        <module>web</module>
        <module>jllm-web</module>
        <module>jacoco</module>
    </modules>

    <properties>
        <revision>1.4.0-jllm</revision>
        <central-publish.skip>false</central-publish.skip>
        <graalvm.version>25.5.5.0.3</graalvm.version>
        <!-- JDBC drivers (MySQL: GPLv2 + FOSS exception; PostgreSQL: BSD): pinned here, never bundled; fetched by scripts/setup (fetch-sql-driver) into .downloaded-libs/ and verified against web/jllm-sql/.../db/drivers/<db>.manifest. SQLite is bundled. -->
        <mysql.version>9.2.0</mysql.version>
        <postgresql.version>42.7.5</postgresql.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
        <spring-ai.version>1.0.0</spring-ai.version>
        <!-- 1.21.4+: tries Docker API 1.44 before 1.32; Docker 29 refuses 1.32 (the Spring Boot 3.5.0 BOM gives 1.21.0) -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- CVE fixes ahead of the Spring Boot BOM (overrides of its version properties) -->
        <tomcat.version>10.1.62</tomcat.version>
        <log4j2.version>2.26.1</log4j2.version>
        <sqlite-jdbc.version>3.54.1.0</sqlite-jdbc.version>
        <httpcore5.version>5.4.4</httpcore5.version>
        <plugins.location>${maven.multiModuleProjectDirectory}/target/plugins</plugins.location>
    </properties>

    <repositories>
        <!-- GraalJS set downloaded by scripts/setup (git-ignored); the gate artifact org.kendar.llm.graal:jllm-graal-set lives here -->
        <repository>
            <id>graal-local</id>
            <url>file://${maven.multiModuleProjectDirectory}/.downloaded-libs/graal/${graalvm.version}/repo</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- Direct entries: properties of this pom do not reach an imported BOM, so the CVE overrides must be managed here -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.21.9</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.28.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.20.0</version>
            </dependency>
            <dependency>
                <groupId>org.mozilla</groupId>
                <artifactId>rhino</artifactId>
                <!-- transitive of swagger-parser (json-schema-core); fixes CVE-2025-66453 -->
                <version>1.7.15.1</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5</artifactId>
                <version>${httpcore5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5-h2</artifactId>
                <version>${httpcore5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>${log4j2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- before spring-boot-dependencies: the first imported BOM wins -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>graal-set-present</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireFilesExist>
                                    <files>
                                        <file>${maven.multiModuleProjectDirectory}/.downloaded-libs/graal/${graalvm.version}/repo/org/kendar/llm/graal/jllm-graal-set/${graalvm.version}/jllm-graal-set-${graalvm.version}.pom</file>
                                    </files>
                                    <message>GraalJS ${graalvm.version} is not set up: run scripts/setup.sh (Windows: scripts\setup.ps1). Run it again after a graalvm.version change.</message>
                                </requireFilesExist>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <jllm.graal.dir>${maven.multiModuleProjectDirectory}/.downloaded-libs/graal/${graalvm.version}</jllm.graal.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- jllm-eval: real-model evaluation, never part of the default build. Use: mvn -Peval -pl eval/jllm-eval -am test -->
        <profile>
            <id>eval</id>
            <modules>
                <module>eval/jllm-eval</module>
            </modules>
        </profile>
        <!-- Dependency scan, never part of the default build. Use: mvn -Powasp verify (see CONTRIBUTING.md).
             Order: package = scan without failing (JSON report) then convert to docs/owasp_dc.md; verify = scan again and fail on CVSS >= 7 (cached database). The threshold runs last so the report is always produced. -->
        <profile>
            <id>owasp</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>13.0.0</version>
                        <inherited>false</inherited>
                        <configuration>
                            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                            <formats>
                                <format>JSON</format>
                            </formats>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <suppressionFiles>
                                <suppressionFile>${maven.multiModuleProjectDirectory}/owasp-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                        </configuration>
                        <executions>
                            <execution>
                                <id>owasp-report</id>
                                <phase>package</phase>
                                <goals><goal>aggregate</goal></goals>
                                <configuration>
                                    <failBuildOnCVSS>11</failBuildOnCVSS>
                                </configuration>
                            </execution>
                            <execution>
                                <id>owasp-threshold</id>
                                <phase>verify</phase>
                                <goals><goal>aggregate</goal></goals>
                                <configuration>
                                    <failBuildOnCVSS>7</failBuildOnCVSS>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>owasp-markdown</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                    <arguments>
                                        <argument>scripts/OwaspReport.java</argument>
                                        <argument>${project.build.directory}/dependency-check-report.json</argument>
                                        <argument>docs/owasp_dc.md</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>deploy</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>package</phase>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>-missing</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>createJavadocs</id>
                                <phase>package</phase>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.2.5</version>
                        <configuration>
                            <updatePomFile>true</updatePomFile>
                            <flattenMode>ossrh</flattenMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals><goal>flatten</goal></goals>
                            </execution>
                            <execution>
                                <id>flatten.clean</id>
                                <phase>clean</phase>
                                <goals><goal>clean</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <skipPublishing>${central-publish.skip}</skipPublishing>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
