<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.kendar.llm</groupId>
        <artifactId>jllm</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>jllm-cli</artifactId>
    <packaging>jar</packaging>
    <name>jllm-cli</name>
    <description>Command line chat over jllm-harness. Runnable fat jar: java -jar jllm-cli.jar [--plugin-dir DIR] (plugins are loaded from the plugin directory)</description>

    <url>https://github.com/kendarorg/jllm</url>

    <scm>
        <connection>scm:git:git://github.com/kendarorg/jllm.git</connection>
        <developerConnection>scm:git:git://github.com/kendarorg/jllm.git</developerConnection>
        <url>https://www.github.com/kendarorg/jllm</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <central-publish.skip>true</central-publish.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.kendar.llm</groupId>
            <artifactId>jllm-harness</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- GraalJS for run_js: provided, never bundled; downloaded by scripts/setup into .downloaded-libs/graal/, the release ships it in lib-ext/ -->
        <dependency>
            <groupId>org.kendar.llm.graal</groupId>
            <artifactId>jllm-graal-set</artifactId>
            <version>${graalvm.version}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>3.30.17</version>
        </dependency>
        <!-- the log binding of the CLI; src/main/resources/simplelogger.properties keeps it quiet -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.kendar.llm.cli.Main</mainClass>
                                    <manifestEntries>
                                        <!-- GraalJS is not in this jar (lib-ext is added to the class path); Truffle still needs a Multi-Release main jar, so the flag stays -->
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- coverage floor of the weakest package: a drop fails "mvn verify" (skipped when there is no jacoco.exec) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes><include>org.kendar.llm.cli</include></includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
