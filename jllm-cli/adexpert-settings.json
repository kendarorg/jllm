{
  "plugins": {
    "pdf": {"enabled": true},
    "docs": {"enabled": true}
  },
  "skills": [
    {"name": "adexpert", "path": "${HOME}/.claude/skills/adexpert/SKILL.md"}
  ],
  "mcpServers": [
    {
      "name": "adexpert",
      "command": "${HOME}/.claude/mcp-servers/adexpert/.venv/bin/python3",
      "args": ["${HOME}/.claude/mcp-servers/adexpert/mcp_server.py"],
      "env": {
        "ADEXPERT_SERVER_URL": "http://localhost:8180",
        "DOCUMENTS_COLLECTION": "none"
      },
      "readOnly": true
    }
  ]
}
