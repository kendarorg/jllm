<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.kendar.llm</groupId>
        <artifactId>jllm</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>jllm-web</artifactId>
    <packaging>jar</packaging>
    <name>jllm-web</name>
    <description>Web front end (chat UI over REST + SSE) for jllm-harness.</description>

    <url>https://github.com/kendarorg/jllm</url>

    <scm>
        <connection>scm:git:git://github.com/kendarorg/jllm.git</connection>
        <developerConnection>scm:git:git://github.com/kendarorg/jllm.git</developerConnection>
        <url>https://www.github.com/kendarorg/jllm</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <central-publish.skip>true</central-publish.skip>
    </properties>

    <dependencies>
        <!-- GraalJS for run_js: provided, never bundled; downloaded by scripts/setup into .graal/, the release ships it in lib-ext/ -->
        <dependency>
            <groupId>org.kendar.llm.graal</groupId>
            <artifactId>jllm-graal-set</artifactId>
            <version>${graalvm.version}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.kendar.llm</groupId>
            <artifactId>jllm-web-spring-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <!-- ZIP layout: the jar starts through PropertiesLauncher, so "java -jar" keeps working and an
                         external folder (lib-ext) can be added with -Dloader.path=lib-ext -->
                    <layout>ZIP</layout>
                    <!-- GraalJS is provided, and provided jars are otherwise repackaged: the release ships it in lib-ext/ -->
                    <excludeGroupIds>org.graalvm.polyglot,org.graalvm.js,org.graalvm.regex,org.graalvm.truffle,org.graalvm.sdk,org.graalvm.shadowed</excludeGroupIds>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
