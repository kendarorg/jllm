<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.kendar.llm</groupId>
        <artifactId>jllm</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>jllm-sql-spring-starter</artifactId>
    <packaging>jar</packaging>
    <name>jllm-sql-spring-starter</name>
    <description>Spring Boot starter: with it on the class path the web application keeps its data in SQL (SQLite default, MySQL).</description>

    <url>https://github.com/kendarorg/jllm</url>

    <scm>
        <connection>scm:git:git://github.com/kendarorg/jllm.git</connection>
        <developerConnection>scm:git:git://github.com/kendarorg/jllm.git</developerConnection>
        <url>https://www.github.com/kendarorg/jllm</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <dependency>
            <groupId>org.kendar.llm</groupId>
            <artifactId>jllm-sql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <!-- the jars the release adds to lib-ext/sql of jllm-web.jar (the starter jar itself is copied by release.sh/.ps1);
                     everything else the starter needs is already inside jllm-web.jar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>sql-lib-ext</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib-sql</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <includeArtifactIds>jllm-sql,HikariCP,sqlite-jdbc</includeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
