# Local Ollama model as target and judge (self-graded).
# CTX_TOKENS must not exceed the context Ollama actually allocates (num_ctx).
# minimal = Ollama reasoning_effort "none": Qwen3 thinking would eat the token budget and leave empty replies.
TARGET_PROVIDER=ollama
TARGET_BASE=http://localhost:11434
TARGET_MODEL=qwen3:30b
TARGET_CTX_TOKENS=16000
TARGET_THINKING=minimal
TARGET_RPM=0
JUDGE_PROVIDER=ollama
JUDGE_MODEL=qwen3:30b
JUDGE_CTX_TOKENS=16000
JUDGE_THINKING=minimal
JUDGE_RPM=0
PARALLELISM=1
TRIALS=1
MAX_TRIALS=2
