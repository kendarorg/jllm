<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.kendar.llm</groupId>
        <artifactId>jllm</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>jllm-eval</artifactId>
    <packaging>jar</packaging>
    <name>jllm-eval</name>
    <description>Test-only module: evaluates the harness with real language models. Built only with -Peval.</description>

    <properties>
        <!-- test groups to run: smoke, full, strategy, compaction, unit (no model needed) -->
        <groups>smoke,unit</groups>
        <!-- test classes run concurrently when run.parallelism > 1; cases of one class stay sequential -->
        <run.parallelism>1</run.parallelism>
        <run.parallel.enabled>false</run.parallel.enabled>
        <run.parallel.classes>same_thread</run.parallel.classes>
        <maven.deploy.skip>true</maven.deploy.skip>
        <central-publish.skip>true</central-publish.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.kendar.llm</groupId>
            <artifactId>jllm-harness</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- TestExecutionListener API for the progress log (EvalProgressListener) -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.kendar.llm</groupId>
            <artifactId>jllm-test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.kendar.llm</groupId>
            <artifactId>jllm-pdf</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.kendar.llm</groupId>
            <artifactId>jllm-docs</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.kendar.llm</groupId>
            <artifactId>jllm-js</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- GraalJS for run_js: provided, never bundled; the release ships it in lib-ext/ (see release/graaljs) -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graalvm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js</artifactId>
            <version>${graalvm.version}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.regex</groupId>
            <artifactId>regex</artifactId>
            <version>${graalvm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js-isolate-community</artifactId>
            <version>${graalvm.version}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.kendar.llm</groupId>
            <artifactId>jllm-workflows</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.20.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <groups>${groups}</groups>
                    <!-- one fork; sequential unless run.parallelism > 1 (JUnit runs whole classes concurrently) -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <parallel>none</parallel>
                    <threadCount>1</threadCount>
                    <trimStackTrace>true</trimStackTrace>
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                    <!-- the version of the project under test, pinned in every run's metadata; unknown from an IDE -->
                    <systemPropertyVariables>
                        <jllm.project.version>${project.version}</jllm.project.version>
                    </systemPropertyVariables>
                    <properties>
                        <configurationParameters>
                            junit.jupiter.execution.parallel.enabled=${run.parallel.enabled}
                            junit.jupiter.execution.parallel.mode.default=same_thread
                            junit.jupiter.execution.parallel.mode.classes.default=${run.parallel.classes}
                            junit.jupiter.execution.parallel.config.strategy=fixed
                            junit.jupiter.execution.parallel.config.fixed.parallelism=${run.parallelism}
                            junit.jupiter.execution.parallel.config.fixed.max-pool-size=${run.parallelism}
                        </configurationParameters>
                    </properties>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- -Dgraal.dir=<folder of GraalJS jars> (see scripts/graal-fetch): tests run on the fetched set instead of the
             provided one, so two copies of the language never meet. Without graal.dir this profile is inactive. -->
        <profile>
            <id>graal-dir</id>
            <activation>
                <property>
                    <name>graal.dir</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>list-graal-jars</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <exportAntProperties>true</exportAntProperties>
                                    <target>
                                        <path id="graal.jar.path">
                                            <fileset dir="${graal.dir}" includes="*.jar"/>
                                        </path>
                                        <pathconvert property="graal.jars" refid="graal.jar.path" pathsep=","/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>org.graalvm.polyglot:polyglot</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.regex:regex</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-language</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.truffle:truffle-api</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.truffle:truffle-runtime</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.truffle:truffle-compiler</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.sdk:collections</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.sdk:jniutils</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.sdk:nativebridge</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.sdk:nativeimage</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.sdk:word</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.shadowed:icu4j</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.shadowed:xz</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-linux-amd64-community</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-linux-aarch64-community</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-darwin-aarch64-community</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-windows-amd64-community</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-linux-amd64</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-linux-aarch64</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-darwin-aarch64</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-windows-amd64</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <additionalClasspathElements>${graal.jars}</additionalClasspathElements>
                            <systemPropertyVariables>
                                <jllm.graal.dir>${graal.dir}</jllm.graal.dir>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
