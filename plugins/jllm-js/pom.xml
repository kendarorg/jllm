<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.kendar.llm</groupId>
        <artifactId>jllm</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>jllm-js</artifactId>
    <packaging>jar</packaging>
    <name>jllm-js</name>
    <description>run_js plugin for jllm-harness: a JavaScript sandbox (GraalJS) over the harness tools.</description>

    <url>https://github.com/kendarorg/jllm</url>

    <scm>
        <connection>scm:git:git://github.com/kendarorg/jllm.git</connection>
        <developerConnection>scm:git:git://github.com/kendarorg/jllm.git</developerConnection>
        <url>https://www.github.com/kendarorg/jllm</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <dependency>
            <groupId>org.kendar.llm</groupId>
            <artifactId>jllm-commons</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.kendar.llm</groupId>
            <artifactId>jllm-harness</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- GraalJS is shipped by the release in lib-ext/ (see release/graaljs), never bundled in the plugin jar -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graalvm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js</artifactId>
            <version>${graalvm.version}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.regex</groupId>
            <artifactId>regex</artifactId>
            <version>${graalvm.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- the isolate of every platform: lets the isolated profile run in the tests (the probe verifies it) -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js-isolate-community</artifactId>
            <version>${graalvm.version}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.kendar.llm</groupId>
            <artifactId>jllm-test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- captures the plugin's log warnings in tests -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>clean-old-plugin-jar</id>
                        <phase>install</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${plugins.location}"/>
                                <delete>
                                    <fileset dir="${plugins.location}" includes="${project.artifactId}-*.jar"/>
                                </delete>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-plugin-jar</id>
                        <phase>install</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${plugins.location}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>${project.artifactId}-${project.version}.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- -Dgraal.dir=<folder of GraalJS jars> (see scripts/graal-fetch): tests run on the fetched set instead of the
             provided one, so two copies of the language never meet. Without graal.dir this profile is inactive. -->
        <profile>
            <id>graal-dir</id>
            <activation>
                <property>
                    <name>graal.dir</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>list-graal-jars</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <exportAntProperties>true</exportAntProperties>
                                    <target>
                                        <path id="graal.jar.path">
                                            <fileset dir="${graal.dir}" includes="*.jar"/>
                                        </path>
                                        <pathconvert property="graal.jars" refid="graal.jar.path" pathsep=","/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>org.graalvm.polyglot:polyglot</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.regex:regex</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-language</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.truffle:truffle-api</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.truffle:truffle-runtime</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.truffle:truffle-compiler</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.sdk:collections</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.sdk:jniutils</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.sdk:nativebridge</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.sdk:nativeimage</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.sdk:word</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.shadowed:icu4j</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.shadowed:xz</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-linux-amd64-community</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-linux-aarch64-community</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-darwin-aarch64-community</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-windows-amd64-community</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-linux-amd64</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-linux-aarch64</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-darwin-aarch64</classpathDependencyExclude>
                                <classpathDependencyExclude>org.graalvm.js:js-isolate-windows-amd64</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <additionalClasspathElements>${graal.jars}</additionalClasspathElements>
                            <systemPropertyVariables>
                                <jllm.graal.dir>${graal.dir}</jllm.graal.dir>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
