# Claude Haiku 5.5 as target, Claude Sonnet 5.5 as judge.
TARGET_PROVIDER=anthropic
TARGET_BASE=https://api.anthropic.com
TARGET_MODEL=claude-haiku-5-5
TARGET_THINKING=
TARGET_CTX_TOKENS=200000
TARGET_RPM=300
JUDGE_PROVIDER=anthropic
JUDGE_BASE=https://api.anthropic.com
JUDGE_MODEL=claude-sonnet-5-5
PARALLELISM=300
TRIALS=1
MAX_TRIALS=2
# DIRTY_TREE=warn   # refuse | warn | allow: tracked files changed since HEAD; a baseline is never stored from a dirty tree
# PASS_K=1,2        # k values of pass@k / pass^k; empty = 1 and MAX_TRIALS
